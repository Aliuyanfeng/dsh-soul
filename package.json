{
  "name": "dsh-soul",
  "version": "0.7.1",
  "description": "为 DeepSeek Harness 添加个性化设置。",
  "icon": "./assets/icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-soul",
    "deepseek",
    "deepseek-harness",
    "personalization",
    "persona",
    "system-prompt",
    "ai-assistant",
    "customization"
  ],
  "type": "module",
  "main": "index.mjs",
  "scripts": {
    "verify": "node scripts/verify-config.mjs && node scripts/verify-store.mjs && node scripts/verify-e2e-prompt.mjs && node scripts/verify-live-prompt.mjs && node scripts/verify-compat.mjs && node scripts/verify-trail.mjs && node scripts/verify-nav-icon.mjs",
    "verify:strict": "node scripts/verify-config.mjs --strict && node scripts/verify-store.mjs --strict && node scripts/verify-e2e-prompt.mjs --strict && node scripts/verify-live-prompt.mjs --strict && node scripts/verify-compat.mjs --strict && node scripts/verify-trail.mjs --strict && node scripts/verify-nav-icon.mjs --strict",
    "verify:store": "node scripts/verify-store.mjs",
    "verify:e2e": "node scripts/verify-e2e-prompt.mjs",
    "verify:host": "node scripts/verify-live-prompt.mjs",
    "verify:compat": "node scripts/verify-compat.mjs",
    "verify:trail": "node scripts/verify-trail.mjs",
    "verify:nav-icon": "node scripts/verify-nav-icon.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aliuyanfeng/dsh-soul.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1 || ^4.0.5-alpha.1",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "default": "./index.mjs"
    },
    "./client": "./client/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib",
    "client",
    "assets",
    "cordis.patch.yml",
    "scripts",
    "README.md",
    "README_EN.md"
  ]
}
