{
  "name": "dsh-soul",
  "version": "0.3.2",
  "description": "为 DeepSeek Harness 添加个性化设置",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "personalization",
    "persona",
    "system-prompt",
    "ai-agent",
    "ai-assistant",
    "customization"
  ],
  "type": "module",
  "main": "index.mjs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aliuyanfeng/dsh-soul.git"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "default": "./index.mjs"
    },
    "./client": "./client/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md"
  ]
}
