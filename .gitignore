*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.cache

# ── 本地环境 / 密钥 ──
.env
.env.*
!.env.example
*.local

# ── 编辑器 & 系统文件 ──
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── npm 凭据（发布用 token，严禁提交）──
.npmrc

reasonix.toml
